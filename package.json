{
  "name": "@undermuz/react-page-builder-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:home-page": "nx dev @undermuz/home-page",
    "build": "nx run-many -t build",
    "build:home-page:pages": "npm run build:pages --workspace=@undermuz/home-page",
    "deploy:home-page": "npm run build:home-page:pages && gh-pages -d apps/home-page/dist -b gh-pages --dotfiles -m \"Deploy home-page to GitHub Pages\"",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test"
  },
  "devDependencies": {
    "@nx/eslint": "23.1.1",
    "@nx/vite": "23.1.1",
    "eslint": "^10.8.1",
    "gh-pages": "^6.3.0",
    "nx": "23.1.1"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
